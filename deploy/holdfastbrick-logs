#!/usr/bin/env bash
# holdfastbrick-logs — follow live logs from the Holdfast Brick stack.
#
# Usage:
#   holdfastbrick-logs            # live Holdfast API logs (default)
#   holdfastbrick-logs api        # same
#   holdfastbrick-logs adguard    # AdGuard Home
#   holdfastbrick-logs unbound    # Unbound (Private DNS)
#   holdfastbrick-logs doh        # Encrypted DNS (unbound DoT — alias of 'unbound')
#   holdfastbrick-logs ntopng     # ntopng (Network Monitor)
#   holdfastbrick-logs nextdns    # NextDNS CLI
#   holdfastbrick-logs tailscale  # tailscaled (Remote Access)
#   holdfastbrick-logs all        # everything, interleaved
#   holdfastbrick-logs api -n 200 # extra args pass through to journalctl
set -euo pipefail

target="${1:-api}"
if [ $# -gt 0 ]; then shift; fi

# AdGuard's unit name differs by install method.
adguard_unit() {
  for unit in AdGuardHome adguardhome; do
    if systemctl cat "$unit" >/dev/null 2>&1; then echo "$unit"; return; fi
  done
  echo "AdGuardHome"
}

case "$target" in
  api)       units=(-u holdfastbrick-api) ;;
  adguard)   units=(-u "$(adguard_unit)") ;;
  unbound)   units=(-u unbound) ;;
  doh)       units=(-u unbound) ;;
  ntopng)    units=(-u ntopng) ;;
  nextdns)   units=(-u nextdns) ;;
  tailscale) units=(-u tailscaled) ;;
  all)       units=(-u holdfastbrick-api -u "$(adguard_unit)" -u unbound
                    -u ntopng -u nextdns -u tailscaled) ;;
  -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
  *)
    echo "Unknown service: ${target}" >&2
    echo "Choose from: api adguard unbound doh ntopng nextdns tailscale all" >&2
    exit 1
    ;;
esac

# Live follow with some recent context; extra args (e.g. -n 500, --since ...)
# pass straight through to journalctl.
exec journalctl "${units[@]}" -f -n 100 --no-hostname "$@"
